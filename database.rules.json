{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
        ".write": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
        "phase":   { ".validate": "newData.isString() && newData.val().matches(/^(lobby|selecting|building|league)$/)" },
        "host":    { ".validate": "newData.isString() && newData.val().length < 20" },
        "created": { ".validate": "newData.isNumber()" },
        "seed":    { ".validate": "newData.isNumber()" },
        "players": {
          "$pid": {
            "nick":    { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
            "teamId":  { ".validate": "newData.isString() && newData.val().length <= 4" },
            "ready":   { ".validate": "newData.isBoolean()" },
            "squadPw": { ".validate": "newData.isNumber()" },
            "ts":      { ".validate": "newData.isNumber()" },
            "seen":    { ".validate": "newData.isNumber()" },
            "$other":  { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
